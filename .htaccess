# Contact
RewriteRule ^contact-us/?$ /contact [R=301,L,NC]
RewriteRule ^contact-us-sm/?$ /contact [R=301,L,NC]
RewriteRule ^contact-us-quiz/?$ /contact [R=301,L,NC]
RewriteRule ^new-dev-contact-us/?$ /contact [R=301,L,NC]
RewriteRule ^veterans-contact-us/?$ /contact [R=301,L,NC]
RewriteRule ^new-patient-packet/?$ /contact [R=301,L,NC]
RewriteRule ^corporate-location/?$ /contact [R=301,L,NC]
RewriteRule ^tms-locations/?$ /contact [R=301,L,NC]
RewriteRule ^tms-locations-california/?$ /contact [R=301,L,NC]
RewriteRule ^tms-locations-texas/?$ /contact [R=301,L,NC]

# Team pages and old clinician URLs
RewriteRule ^team-texas/?$ /team [R=301,L,NC]
RewriteRule ^team-texas-2/?$ /team [R=301,L,NC]
RewriteRule ^team-texas-2/executive/?$ /about [R=301,L,NC]
RewriteRule ^team-texas-2/therapists/?$ /team [R=301,L,NC]
RewriteRule ^team-texas/executive/?$ /about [R=301,L,NC]
RewriteRule ^team-texas/therapists/?$ /team [R=301,L,NC]
