RewriteRule ^psychiatrist-grapevine-tx/?$ /grapevine [R=301,L,NC]

# Clinics: Houston (Sugar Land has no clinic page; Cypress is the nearest)
RewriteRule ^tms-cypress-tx/?$ /cypress [R=301,L,NC]
RewriteRule ^therapist-cypress-tx/?$ /cypress [R=301,L,NC]
RewriteRule ^psychiatrist-cypress-tx/?$ /cypress [R=301,L,NC]
RewriteRule ^thewoodlands/?$ /the-woodlands [R=301,L,NC]
RewriteRule ^tms-sugar-land-tx/?$ /cypress [R=301,L,NC]
RewriteRule ^therapist-sugar-land-tx/?$ /cypress [R=301,L,NC]
RewriteRule ^psychiatrist-sugar-land-tx/?$ /cypress [R=301,L,NC]

# Blog posts: the 145 articles from the old site are published again at
# their original addresses (e.g. /what-is-mdd-disorder), so they need no
# redirect. /blog itself goes to the new /blogs index above.

# WordPress archives, feeds and attachment pages that Google may still hold.
RewriteRule ^(category|tag|author)(/.*)?$ / [R=301,L,NC]
RewriteRule ^page/[0-9]+/?$ / [R=301,L,NC]
RewriteRule ^(.+/)?feed/?$ / [R=301,L,NC]
RewriteRule ^wp-(content|includes|admin|login\.php|json)(/.*)?$ / [R=301,L,NC]
RewriteRule ^locations\.kml$ /contact [R=301,L,NC]

# ── 3. Canonical URLs: /index.html and /about.html → / and /about ────
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ── 4. No trailing slash (not for real directories) ───────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── 5. Serve /about from about.html ───────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ── Caching and headers (mirrors what netlify.toml set) ────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|js|png|jpe?g|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
