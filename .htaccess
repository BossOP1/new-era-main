# Anew Era TMS & Psychiatry — Apache config for cPanel hosting.
#
# Upload the contents of dist/ (this file included) to public_html/.
# The file does four jobs, in this order:
#   1. https and the bare domain (no www)
#   2. 301s from the old WordPress site's URLs to their new pages, so the
#      rankings those URLs earned carry over
#   3. clean URLs: /about serves about.html, the way the site links
#   4. no trailing slashes, because the pages use relative links
#
# Generated from the old site's sitemaps (aneweratms.com/sitemap_index.xml,
# October 2026). Old URLs whose slug matches a new page (/therapy/, /faq/,
# /dexter-jones/ …) need no rule: step 4 drops the slash and step 3 serves
# the page. Rules are anchored RewriteRules rather than "Redirect", which
# matches prefixes — "Redirect /tms" would also catch /tms-reviews.

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ── 1. https and no www ────────────────────────────────────────────────
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# ── 2. Old site → new site (301) ───────────────────────────────────────
RewriteRule ^careers/?$ https://discoverybehavioralhealth.com/careers/jobs/?location=Anew+Era+TMS [R=301,L,NC]

# Clinicians who have left: their profile goes to the team page
RewriteRule ^laura-ann-beaufford(\.html)?/?$ /team [R=301,L,NC]

