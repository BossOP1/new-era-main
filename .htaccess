# Conditions
RewriteRule ^conditions-treated/?$ /conditions [R=301,L,NC]
RewriteRule ^new-development-conditions-treated/?$ /conditions [R=301,L,NC]
RewriteRule ^tms-for-ptsd/?$ /ptsd [R=301,L,NC]
RewriteRule ^tms-migraines/?$ /migraines [R=301,L,NC]
RewriteRule ^tms-tinnitus/?$ /conditions [R=301,L,NC]

# Screening quizzes
RewriteRule ^depression-quiz/?$ /phq9 [R=301,L,NC]
RewriteRule ^depression-screening/?$ /phq9 [R=301,L,NC]
RewriteRule ^quiz-test/?$ /phq9 [R=301,L,NC]
RewriteRule ^qsm_quiz/?$ /phq9 [R=301,L,NC]
RewriteRule ^qsm_quiz/depression-quiz/?$ /phq9 [R=301,L,NC]
