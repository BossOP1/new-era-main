# WordPress archives, feeds and attachment pages that Google may still hold.
RewriteRule ^(category|tag|author)(/.*)?$ / [R=301,L,NC]
RewriteRule ^page/[0-9]+/?$ / [R=301,L,NC]
RewriteRule ^(.+/)?feed/?$ / [R=301,L,NC]
RewriteRule ^wp-(content|includes|admin|login\.php|json)(/.*)?$ / [R=301,L,NC]
RewriteRule ^locations\.kml$ /contact [R=301,L,NC]

# ── 3. Canonical URLs: /index.html and /about.html → / and /about ────
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ── 4. No trailing slash (not for real directories) ───────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── 5. Serve /about from about.html ───────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ── Caching and headers (mirrors what netlify.toml set) ────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|js|png|jpe?g|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
