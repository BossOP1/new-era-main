RewriteRule ^terry-eagan/?$ /terry-v-eagan [R=301,L,NC]
RewriteRule ^psychiatrist-2/tiffany-nix/?$ /tiffany-a-nix [R=301,L,NC]
RewriteRule ^tiffany-nix/?$ /tiffany-a-nix [R=301,L,NC]
RewriteRule ^psychiatrist-2/john-anthony-diya/?$ /john-anthony-diya [R=301,L,NC]
