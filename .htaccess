# Anew Era TMS & Psychiatry — Apache config for cPanel hosting.
#
# Upload the contents of dist/ (this file included) to public_html/.
# The file does four jobs, in this order:
#   1. https and the bare domain (no www)
#   2. 301s from the old WordPress site's URLs to their new pages, so the
#      rankings those URLs earned carry over
#   3. clean URLs: /about serves about.html, the way the site links
#   4. no trailing slashes, because the pages use relative links
#
# Generated from the old site's sitemaps (aneweratms.com/sitemap_index.xml,
# October 2026). Old URLs whose slug matches a new page (/therapy/, /faq/,
# /dexter-jones/ …) need no rule: step 4 drops the slash and step 3 serves
# the page. Rules are anchored RewriteRules rather than "Redirect", which
# matches prefixes — "Redirect /tms" would also catch /tms-reviews.

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ── 1. https and no www ────────────────────────────────────────────────
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# ── 2. Old site → new site (301) ───────────────────────────────────────
RewriteRule ^careers/?$ https://discoverybehavioralhealth.com/careers/jobs/?location=Anew+Era+TMS [R=301,L,NC]

# Clinicians who have left: their profile goes to the team page
RewriteRule ^laura-ann-beaufford(\.html)?/?$ /team [R=301,L,NC]

# Home and general
RewriteRule ^blog/?$ /blogs [R=301,L,NC]
RewriteRule ^covid-19/?$ /faq [R=301,L,NC]
RewriteRule ^unsubscribe/?$ / [R=301,L,NC]
RewriteRule ^newsletter/?$ / [R=301,L,NC]
RewriteRule ^mental-health-ebook/?$ / [R=301,L,NC]
RewriteRule ^self-love-month/?$ / [R=301,L,NC]
RewriteRule ^mental-health-awareness-month/?$ / [R=301,L,NC]
RewriteRule ^depression-month/?$ /depression [R=301,L,NC]
RewriteRule ^depression-month-austin/?$ /central-austin [R=301,L,NC]
RewriteRule ^holiday/?$ /tms [R=301,L,NC]
RewriteRule ^home-spotify-ad/?$ /tms [R=301,L,NC]
RewriteRule ^holiday-season-treatment-anew-era-tms-psychiatry/?$ /tms [R=301,L,NC]
RewriteRule ^tms-depression-treatment-california-holidays/?$ /tms [R=301,L,NC]
RewriteRule ^tms-depression-treatment-austin-holidays/?$ /central-austin [R=301,L,NC]
RewriteRule ^tms-depression-treatment-dallas-holidays/?$ /central-dallas [R=301,L,NC]
RewriteRule ^google-ca/?$ / [R=301,L,NC]
RewriteRule ^google-ca-1/?$ / [R=301,L,NC]
RewriteRule ^google-austin/?$ /central-austin [R=301,L,NC]
RewriteRule ^google-dallas/?$ /central-dallas [R=301,L,NC]
RewriteRule ^google-houston/?$ /cypress [R=301,L,NC]
RewriteRule ^in-the-media/?$ /about [R=301,L,NC]
RewriteRule ^mission-vision/?$ /about [R=301,L,NC]
RewriteRule ^privacy-policy/?$ /privacy [R=301,L,NC]
RewriteRule ^test/?$ / [R=301,L,NC]
RewriteRule ^w2l-form-shortcode-test/?$ / [R=301,L,NC]
RewriteRule ^portfolio-item/john-smith/?$ / [R=301,L,NC]
RewriteRule ^portfolio_entries/team-member/?$ /team [R=301,L,NC]

# Partner and referral pages that no longer exist
RewriteRule ^arise-recovery-centers/?$ / [R=301,L,NC]
RewriteRule ^spain-sober-living/?$ / [R=301,L,NC]
RewriteRule ^blue-sky-sober-living/?$ / [R=301,L,NC]
RewriteRule ^trinity_river_recovery/?$ / [R=301,L,NC]

# Treatments
RewriteRule ^seeking-tms/?$ /tms [R=301,L,NC]
RewriteRule ^tms-therapy-information/?$ /tms [R=301,L,NC]
